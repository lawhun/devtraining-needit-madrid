<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.strscout.cocoa-beach</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>SCRIPTS_DIR/generate-cocoa-beach.sh</string>
    </array>

    <!-- Daily at 7:30 AM local time (30 min after Mansfield at 7:00 AM — adjust Hour/Minute to match) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>HOME_DIR/STR-Scouts/logs/cocoa-beach-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_DIR/STR-Scouts/logs/cocoa-beach-launchd-err.log</string>
</dict>
</plist>
